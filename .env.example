APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Postgres locally, because production and CI run Postgres and the two
# disagree in ways a test on SQLite cannot see. jsonb reordering a design
# reached production once that way. Port 5433 and the root user with no
# password are Herd's own Postgres. Create the two databases with:
#   create database design_dashcore; create database design_dashcore_test;
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=design_dashcore
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Design generator (Phase 2)
ANTHROPIC_API_KEY=
DESIGN_MODEL=claude-fable-5-1
DESIGN_EFFORT=medium
DESIGN_KEEP_RAW=true

# Fleet membership — the only two values `php artisan bridge:connect` needs.
# On Herd: BRIDGE_CONTROL_URL=https://api.dashcore.com.test
BRIDGE_FLEET_KEY=
BRIDGE_CONTROL_URL=https://api.dashcore.com

# The largest upload that passes through PHP, so standards.dashcore.com can
# send one that size through Cloudflare, the web server and PHP: Takes no uploads.
BRIDGE_UPLOAD_MAX=none
