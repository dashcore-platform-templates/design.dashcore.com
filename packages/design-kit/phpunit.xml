<?xml version="1.0" encoding="UTF-8"?>
<!--
    Runs the package's tests on their own, with no Laravel app around them.
    The design repo also runs this directory, as its DesignKit suite, so the
    two never drift.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="DesignKit">
            <directory>tests</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>src</directory>
        </include>
    </source>
</phpunit>
